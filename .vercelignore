# Excludes files from CLI deploys. Note this does NOT apply to Git-based
# deployments — Vercel clones the whole repo for those. Anything that must never
# ship should simply not live under public/.

# Guard: HEIC is unrenderable in browsers. The 127 originals were removed from
# the repo (client holds the masters); this keeps stray ones from shipping.
*.HEIC
*.heic

